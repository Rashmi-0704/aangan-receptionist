# Copy to .env.local and fill in. Never commit real values.
# Leave a key empty to run that integration in mock / skip mode (logged on startup of each request).

# ---- App ----
APP_URL=http://localhost:3000
# Basic-auth password for the dashboard and /api/test-call. Empty = no auth (local dev only).
DASHBOARD_PASSWORD=
# Business hours used to flag after-hours calls (24h clock, Asia/Kolkata)
OFFICE_OPEN_HOUR=10
OFFICE_CLOSE_HOUR=19

# ---- Neon Postgres (required) ----
# Neon console → your project → Connect → copy the connection string (postgresql://...sslmode=require)
DATABASE_URL=

# ---- Vaani (app.vaanivoice.ai) — empty API key = MOCK mode ----
# Developers → API Keys (starts with vaani_)
VAANI_API_KEY=
# Any long random string. Vaani webhook URL = https://<app>/api/webhooks/vaani?token=<this>
VAANI_WEBHOOK_SECRET=
# Only for /api/tools/* (unused unless a voice provider calls our booking tools mid-call)
VAANI_TOOL_SECRET=
# Vaani's webhook has no cost field; cost is estimated from call duration
VAANI_COST_PER_MIN_INR=5.6

# ---- Gemini (classifier) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per 1M tokens, in INR, for cost tracking — check current Gemini pricing for your model
GEMINI_INPUT_COST_PER_M_INR=25
GEMINI_OUTPUT_COST_PER_M_INR=210

# ---- Cal.com (booking) — empty = mock bookings ----
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_SLUG=consultation
CAL_TIMEZONE=Asia/Kolkata
# Simulated calls only: real inbox used as the attendee email (Cal.com rejects example.com)
TEST_BOOKING_EMAIL=

# ---- Resend (designer email) — empty = email skipped and logged ----
RESEND_API_KEY=
RESEND_FROM=Aangan Receptionist <receptionist@yourdomain.com>
# Designers, round-robin: "Name:email,Name:email"
DESIGNERS=Designer One:designer1@example.com,Designer Two:designer2@example.com

# ---- HubSpot (CRM) — empty = MOCK mode (writes to the crm_mock table) ----
HUBSPOT_ACCESS_TOKEN=
